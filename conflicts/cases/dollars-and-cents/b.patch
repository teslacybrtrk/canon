@@ -0,0 +1,8 @@
+import { products } from "./catalog";
+import { money } from "./money";
+
+// The till's price list: one line per product, for the printer by the register.
+export function priceList(): Response {
+  const lines = products().map((p) => `${p.id} ${money(p.price)}`);
+  return new Response(`${lines.join("\n")}\n`, { headers: { "content-type": "text/plain; charset=utf-8" } });
+}
