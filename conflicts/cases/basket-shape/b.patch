index 040f5bd..adda9b3 100644
--- a/src/cart.ts
+++ b/src/cart.ts
@@ -17,6 +17,16 @@ export class Cart extends DurableObject {
     return { ok: true };
   }
 
+  // Takes one of a product back out of the basket; the line goes when none are left.
+  async takeOne(id: string): Promise<boolean> {
+    const lines = (await this.ctx.storage.get<Record<string, number>>("lines")) ?? {};
+    if (!lines[id]) return false;
+    if (lines[id] > 1) lines[id] -= 1;
+    else delete lines[id];
+    await this.ctx.storage.put("lines", lines);
+    return true;
+  }
+
   async view(): Promise<Quote> {
     const lines = (await this.ctx.storage.get<Record<string, number>>("lines")) ?? {};
     return quote(Object.entries(lines).map(([id, qty]) => ({ id, qty })));
