{
  "version": 1,
  "facts": [
    { "id": "shop-page-lists-prices", "sentence": "The shop page lists the products with their prices", "check": { "kind": "probe", "isolate": false, "steps": [{ "path": "/", "expect": { "status": 200, "bodyIncludes": "Kale bunch: $3.20" } }] } },
    { "id": "one-unit-at-list-price", "sentence": "A quote for one unit charges the listed price", "check": { "kind": "probe", "isolate": false, "samples": 3, "vars": { "item": { "oneOf": [{ "id": "eggs", "cents": 400 }, { "id": "kale", "cents": 320 }, { "id": "greens", "cents": 480 }] } }, "steps": [{ "path": "/api/quote?item={{item.id}}&qty=1", "expect": { "status": 200, "json": { "subtotal": "{{item.cents}}" } } }] } },
    { "id": "vat-is-a-quarter", "sentence": "VAT is 25% of the subtotal, and the total is the subtotal plus VAT", "check": { "kind": "probe", "isolate": false, "samples": 5, "vars": { "qty": { "int": [1, 20] }, "item": { "oneOf": ["eggs", "kale", "greens"] } }, "steps": [{ "path": "/api/quote?item={{item}}&qty={{qty}}", "expect": { "status": 200 }, "save": { "subtotal": "subtotal" } }, { "path": "/api/quote?item={{item}}&qty={{qty}}", "expect": { "status": 200, "json": { "vat": "{{subtotal * 0.25}}", "total": "{{subtotal * 1.25}}" } } }] } },
    { "id": "unknown-item-refused", "sentence": "An item the shop doesn't sell can't be quoted", "check": { "kind": "probe", "isolate": false, "steps": [{ "path": "/api/quote?item=turnip&qty=1", "expect": { "status": 400 } }] } },
    { "id": "cart-starts-empty", "sentence": "A new shopper's basket is empty", "check": { "kind": "probe", "steps": [{ "path": "/api/cart", "expect": { "status": 200, "json": { "lines.length": 0, "total": 0 } } }] } },
    { "id": "cart-keeps-lines", "sentence": "The basket keeps what was added, at the listed price plus VAT", "check": { "kind": "probe", "steps": [{ "method": "POST", "path": "/api/cart", "body": { "id": "eggs", "qty": 2 }, "expect": { "status": 200 } }, { "method": "POST", "path": "/api/cart", "body": { "id": "kale", "qty": 1 }, "expect": { "status": 200 } }, { "path": "/api/cart", "expect": { "status": 200, "json": { "lines.length": 2, "subtotal": 1120, "total": 1400 } } }] } },
    { "id": "unknown-product-refused", "sentence": "A product the shop doesn't sell can't be added to the basket", "check": { "kind": "probe", "steps": [{ "method": "POST", "path": "/api/cart", "body": { "id": "turnip", "qty": 1 }, "expect": { "status": 400 } }, { "path": "/api/cart", "expect": { "status": 200, "json": { "lines.length": 0 } } }] } },
    { "id": "code-typechecks", "sentence": "The code type-checks, with no errors silenced", "check": { "kind": "command", "run": "npx tsc --noEmit -p tsconfig.json && ! grep -rnE '@ts-(ignore|nocheck|expect-error)' src" }, "scope": ["src/**", "tsconfig.json", "package.json", "package-lock.json"] },
    { "id": "code-lints", "sentence": "The code passes the linter, with no rules silenced", "check": { "kind": "command", "run": "npx biome lint src && ! grep -rn 'biome-ignore' src" }, "scope": ["src/**", "biome.json", "package.json", "package-lock.json"] }
  ]
}
