{
  "version": 1,
  "facts": [
    { "id": "page-lists-items", "sentence": "The page lists every item with its price", "check": { "kind": "probe", "isolate": false, "steps": [{ "path": "/", "expect": { "status": 200, "bodyIncludes": "Kale bunch: $3.00" } }] } },
    { "id": "quote-is-price-times-qty", "sentence": "A quote is the item's price times the quantity", "check": { "kind": "probe", "isolate": false, "samples": 3, "vars": { "qty": { "int": [1, 9] }, "item": { "oneOf": [{ "id": "eggs", "cents": 400 }, { "id": "kale", "cents": 300 }] } }, "steps": [{ "path": "/api/quote?item={{item.id}}&qty={{qty}}", "expect": { "status": 200, "json": { "cents": "{{qty * item.cents}}" } } }] } },
    { "id": "unknown-item-refused", "sentence": "An unknown item can't be quoted", "check": { "kind": "probe", "isolate": false, "steps": [{ "path": "/api/quote?item=turnip&qty=1", "expect": { "status": 400 } }] } },
    { "id": "code-typechecks", "sentence": "The code type-checks, with no errors silenced", "check": { "kind": "command", "run": "npx tsc --noEmit -p tsconfig.json && ! grep -rnE '@ts-(ignore|nocheck|expect-error)' src" }, "scope": ["src/**", "tsconfig.json", "package.json", "package-lock.json"] }
  ],
  "backlog": [
    { "id": "bulk-discount", "sentence": "Ten or more of an item take 10% off the quote", "check": { "kind": "probe", "isolate": false, "steps": [{ "path": "/api/quote?item=eggs&qty=10", "expect": { "status": 200, "json": { "cents": 3600 } } }, { "path": "/api/quote?item=eggs&qty=9", "expect": { "json": { "cents": 3600 } } }] } },
    { "id": "quote-has-name", "sentence": "A quote names the item", "check": { "kind": "probe", "isolate": false, "steps": [{ "path": "/api/quote?item=honey&qty=2", "expect": { "status": 200, "json": { "name": "Wildflower honey", "cents": 2400 } } }] } }
  ],
  "policy": { "autoAccept": "backlog", "batch": false, "canary": { "steps": [10, 50], "holdSeconds": 45 }, "state": "none" },
  "production": "https://canary.canon-rodeo.workers.dev"
}
