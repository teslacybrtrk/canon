{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farmstand",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No account here: CI and the scripts pass CLOUDFLARE_ACCOUNT_ID. No routes either: production is
  // <project>.<subdomain>.workers.dev, or a custom domain attached to the Worker once (farmstand.canon.rodeo).
  // Previews stay on workers.dev, where the judge's Worker can fetch them.
  "workers_dev": true,
  "preview_urls": true,
  "durable_objects": { "bindings": [{ "name": "MARKET", "class_name": "Market" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Market"] }],
  // Each Preview automatically gets its own Durable Object namespace, so every
  // attempt's state is isolated. The binding is repeated here because the code
  // reads it from env.
  "previews": {
    "durable_objects": { "bindings": [{ "name": "MARKET", "class_name": "Market" }] }
  }
}
