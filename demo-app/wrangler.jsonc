{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farmstand",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": { "bindings": [{ "name": "MARKET", "class_name": "Market" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Market"] }],
  // Each Preview automatically gets its own Durable Object namespace, so every
  // world's state is isolated without extra config.
  "previews": {}
}
