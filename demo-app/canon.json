{
  "version": 1,
  "facts": [
    {
      "id": "market-lists-stalls",
      "sentence": "The market page lists every stall",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "path": "/",
            "expect": {
              "status": 200,
              "bodyIncludes": "Two Oaks Greens"
            }
          }
        ]
      }
    },
    {
      "id": "products-have-prices",
      "sentence": "All six products are for sale with a price",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "path": "/api/products",
            "expect": {
              "status": 200,
              "json": {
                "length": 6,
                "0.priceCents": {
                  "$exists": true
                },
                "5.priceCents": {
                  "$exists": true
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "cart-starts-empty",
      "sentence": "A new shopper's basket is empty",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "path": "/api/cart",
            "expect": {
              "status": 200,
              "json": {
                "items.length": 0,
                "totalCents": 0
              }
            }
          }
        ]
      }
    },
    {
      "id": "price-is-listed",
      "sentence": "The basket charges the listed price for every unit",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "method": "POST",
            "path": "/api/cart",
            "body": {
              "productId": "eggs",
              "qty": 12
            },
            "expect": {
              "status": 200
            }
          },
          {
            "path": "/api/cart",
            "expect": {
              "status": 200,
              "json": {
                "totalCents": 4800
              }
            }
          }
        ]
      }
    },
    {
      "id": "unknown-product-refused",
      "sentence": "A product that does not exist cannot be added",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "method": "POST",
            "path": "/api/cart",
            "body": {
              "productId": "turnip",
              "qty": 1
            },
            "expect": {
              "status": 400
            }
          }
        ]
      }
    },
    {
      "id": "page-is-fast",
      "sentence": "The market page answers in under 400 ms (p95 of 20 requests)",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "path": "/",
            "repeat": 20,
            "expect": {
              "status": 200,
              "p95Ms": 400
            }
          }
        ]
      }
    },
    {
      "id": "code-typechecks",
      "sentence": "The code type-checks with no errors",
      "check": {
        "kind": "command",
        "run": "npx tsc --noEmit -p tsconfig.json"
      },
      "scope": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "package-lock.json"
      ]
    },
    {
      "id": "code-lints",
      "sentence": "The code passes the linter",
      "check": {
        "kind": "command",
        "run": "npx biome lint src"
      },
      "scope": [
        "src/**",
        "biome.json",
        "package.json",
        "package-lock.json"
      ]
    },
    {
      "id": "tooling-locked",
      "sentence": "Lint and type-check settings only change by revision",
      "check": {
        "kind": "command",
        "run": "printf '%s  %s\\n' 59a84695d901baa34c3e99fbdd740360528a175aac378dcf15ac29992af8dade biome.json a1ddb318478c949d6dea887eafb411b99e9cc602305330ff161315d6b33f9daa tsconfig.json | sha256sum -c --quiet -"
      },
      "scope": [
        "biome.json",
        "tsconfig.json"
      ]
    }
  ]
}
