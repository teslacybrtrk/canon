{
  "version": 1,
  "facts": [
    {
      "id": "market-lists-stalls",
      "sentence": "The market page lists every stall",
      "check": {
        "kind": "probe",
        "isolate": false,
        "steps": [
          {
            "path": "/",
            "expect": {
              "status": 200,
              "bodyIncludes": "Two Oaks Greens"
            }
          }
        ]
      }
    },
    {
      "id": "products-have-prices",
      "sentence": "All six products are for sale with a price",
      "check": {
        "kind": "probe",
        "isolate": false,
        "steps": [
          {
            "path": "/api/products",
            "expect": {
              "status": 200,
              "json": {
                "length": 6,
                "0.priceCents": {
                  "$exists": true
                },
                "5.priceCents": {
                  "$exists": true
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "cart-starts-empty",
      "sentence": "A new shopper's basket is empty",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "path": "/api/cart",
            "expect": {
              "status": 200,
              "json": {
                "items.length": 0,
                "totalCents": 0
              }
            }
          }
        ]
      }
    },
    {
      "id": "small-basket-listed-price",
      "sentence": "A small basket (under $50, fewer than 10 of each item) is charged the listed price",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "method": "POST",
            "path": "/api/cart",
            "body": {
              "productId": "kale",
              "qty": 3
            },
            "expect": {
              "status": 200
            }
          },
          {
            "method": "POST",
            "path": "/api/cart",
            "body": {
              "productId": "eggs",
              "qty": 2
            },
            "expect": {
              "status": 200
            }
          },
          {
            "path": "/api/cart",
            "expect": {
              "status": 200,
              "json": {
                "totalCents": 1700
              }
            }
          }
        ]
      }
    },
    {
      "id": "unknown-product-refused",
      "sentence": "A product that does not exist cannot be added",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "method": "POST",
            "path": "/api/cart",
            "body": {
              "productId": "turnip",
              "qty": 1
            },
            "expect": {
              "status": 400
            }
          }
        ]
      }
    },
    {
      "id": "page-is-fast",
      "sentence": "The market page answers in under 400 ms (p95 of 20 requests)",
      "check": {
        "kind": "probe",
        "isolate": false,
        "steps": [
          {
            "path": "/",
            "repeat": 20,
            "expect": {
              "status": 200,
              "p95Ms": 400
            }
          }
        ]
      }
    },
    {
      "id": "code-typechecks",
      "sentence": "The code type-checks, with no errors silenced",
      "check": {
        "kind": "command",
        "run": "npx tsc --noEmit -p tsconfig.json && ! grep -rnE '@ts-(ignore|nocheck|expect-error)' src"
      },
      "scope": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "package-lock.json"
      ]
    },
    {
      "id": "code-lints",
      "sentence": "The code passes the linter, with no rules silenced",
      "check": {
        "kind": "command",
        "run": "npx biome lint src && ! grep -rn 'biome-ignore' src"
      },
      "scope": [
        "src/**",
        "biome.json",
        "package.json",
        "package-lock.json"
      ]
    },
    {
      "id": "tooling-locked",
      "sentence": "The toolchain, its settings and the deploy config only change by revision",
      "check": {
        "kind": "command",
        "run": "printf '%s  %s\\n' 59a84695d901baa34c3e99fbdd740360528a175aac378dcf15ac29992af8dade biome.json a1ddb318478c949d6dea887eafb411b99e9cc602305330ff161315d6b33f9daa tsconfig.json 09fae007142ecda384682d56b4e2722c8aa8e6dfe0cc22cc4fc7ddcdc2b0d347 package.json a98b8cef882d0c67f22ca1da2934aa734385472ff9a1d2a8a9e8f30037cd40a3 package-lock.json 50366893390b0f0994b713feb40b4e2e296b307b6d63fdd66df1ed1609264c05 wrangler.jsonc | sha256sum -c --quiet -"
      },
      "scope": [
        "biome.json",
        "tsconfig.json",
        "package.json",
        "package-lock.json",
        "wrangler.jsonc"
      ]
    }
  ],
  "backlog": [
    {
      "id": "bulk-discount",
      "sentence": "Buying 10 or more of one item takes 10% off that line",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "method": "POST",
            "path": "/api/cart",
            "body": {
              "productId": "duck-eggs",
              "qty": 10
            },
            "expect": {
              "status": 200
            }
          },
          {
            "path": "/api/cart",
            "expect": {
              "status": 200,
              "json": {
                "items.0.lineCents": 5850,
                "totalCents": 5850
              }
            }
          }
        ]
      }
    },
    {
      "id": "order-discount",
      "sentence": "A basket of $50 or more gets $5 off its total",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "method": "POST",
            "path": "/api/cart",
            "body": {
              "productId": "duck-eggs",
              "qty": 9
            },
            "expect": {
              "status": 200
            }
          },
          {
            "path": "/api/cart",
            "expect": {
              "status": 200,
              "json": {
                "totalCents": 5350
              }
            }
          }
        ]
      }
    },
    {
      "id": "stall-hours",
      "sentence": "Every stall shows its opening hours",
      "check": {
        "kind": "probe",
        "steps": [
          {
            "path": "/api/stalls",
            "expect": {
              "status": 200,
              "json": {
                "0.hours": {
                  "$exists": true
                },
                "2.hours": {
                  "$exists": true
                }
              }
            }
          },
          {
            "path": "/",
            "expect": {
              "bodyIncludes": "Open"
            }
          }
        ]
      }
    }
  ],
  "policy": {
    "autoAccept": "charter",
    "batch": false,
    "charter": {
      "review": [
        "migrations/**",
        "src/auth/**"
      ]
    }
  }
}
