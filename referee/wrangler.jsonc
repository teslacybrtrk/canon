{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canon-referee",
  "account_id": "2d9aba350caa70abf3ce6c910950ffd0",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // The board, the API and (day 7) read-only Git clones live at https://canon.rodeo.
  // workers_dev stays on as a fallback URL.
  "routes": [{ "pattern": "canon.rodeo", "custom_domain": true }],
  "workers_dev": true,

  // Every world is a repo in this namespace: "<project>-genesis", "<project>-<id>".
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "canon" },
    // Canon's own source, served read-only at canon.rodeo/canon.git and /src.
    { "binding": "SOURCE", "namespace": "canon-src" }
  ],

  // Referee: one SQLite-backed Durable Object per project.
  // CiSandbox: containers that build Previews and run production deploys.
  "durable_objects": {
    "bindings": [
      { "name": "REFEREE", "class_name": "Referee" },
      { "name": "SANDBOX", "class_name": "CiSandbox" }
    ]
  },
  "exports": {
    "Referee": { "type": "durable-object", "storage": "sqlite" },
    "CiSandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "containers": [
    { "class_name": "CiSandbox", "image": "docker.io/cloudflare/sandbox:0.12.1", "max_instances": 20, "instance_type": "standard-4" }
  ],

  // Move 3 is plain `git push`; this trigger is how the referee hears it.
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "canon" },
        "targets": [{ "type": "workflow", "workflow_name": "canon-verify" }]
      }
    ]
  },
  "workflows": [
    { "name": "canon-verify", "binding": "CI_WORKFLOW", "class_name": "VerifyWorld" },
    { "name": "canon-promote", "binding": "PROMOTE_WORKFLOW", "class_name": "PromoteWorld" }
  ],
  "r2_buckets": [{ "binding": "BACKUP_BUCKET", "bucket_name": "canon-ci-snapshots" }],

  "vars": {
    "ARTIFACTS_NAMESPACE": "canon",
    // Bump to give every project a fresh referee (see scripts/reset-project.sh).
    // Flip to "true" on submission day to publish canon.rodeo/canon.git and /src.
    "SOURCE_PUBLIC": "true",
    "REFEREE_EPOCH": "11",
    "BACKUP_BUCKET_NAME": "canon-ci-snapshots",
    "CLOUDFLARE_ACCOUNT_ID": "2d9aba350caa70abf3ce6c910950ffd0",
    // Preview URLs are "<preview-name>-<worker-name>.<your-subdomain>.workers.dev".
    "PREVIEW_URL_TEMPLATE": "https://{name}-farmstand.philipemanuele.workers.dev",
    "PRODUCTION_URL": "https://{project}.philipemanuele.workers.dev"
  },
  // Secrets (wrangler secret put): CF_TOKEN, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
  // CANON_KEY (owner: genesis and accepting facts), CANON_AGENT_KEY (agents: claim, never accept)
  "observability": { "enabled": true, "logs": { "enabled": true } }
}
